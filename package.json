{
  "name": "jr-autorag",
  "version": "0.1.0",
  "description": "Local-first RAG workbench for document ingestion, grounded answers, citations, traces, evaluation, and secure client handoff",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "author": {
    "name": "Jonathan R. Reed",
    "url": "https://jonathanrreed.com/about/"
  },
  "homepage": "https://jonathanrreed.com/projects/jr-autorag/",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanRReed/JR-AutoRAG.git"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:all": "bash ./scripts/dev.sh",
    "api:sync": "uv sync --project api --all-groups --extra ml",
    "api:test": "cd api && uv run pytest",
    "api:lint": "cd api && uv run ruff check app tests",
    "start": "NODE_ENV=production bun src/index.ts",
    "doctor": "bash ./scripts/doctor.sh",
    "doctor:test": "env -i PATH=\"$PATH\" HOME=\"$HOME\" bash ./scripts/doctor.test.sh",
    "container:smoke": "bash ./scripts/container-build-smoke.sh",
    "research:check": "bash ./scripts/research-architecture-check.sh",
    "supply-chain": "bash ./scripts/supply-chain-evidence.sh",
    "evidence:bundle": "bash ./scripts/evidence-bundle.sh",
    "evidence:test": "bash ./scripts/evidence-bundle.test.sh",
    "handoff:gate": "bash ./scripts/client-handoff-gate.sh",
    "handoff:test": "bash ./scripts/client-handoff-gate.test.sh",
    "audit:shadscan": "bunx @shadscan/cli@0.17.0 --json --no-interactive --no-roast",
    "audit:shadscan:prompt": "bunx @shadscan/cli@0.17.0 --prompt --no-interactive --no-roast",
    "verify": "bash ./scripts/verify.sh",
    "build": "bash ./scripts/build.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "ci": "bash ./scripts/verify.sh"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/bun": "latest",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
